{
  "name": "china-football-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Static China football league dashboard with GitHub Actions data refresh.",
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed-data.js",
    "fetch:standings": "node scripts/fetch-standings.js",
    "fetch:attendance": "node scripts/fetch-attendance.js",
    "fetch:attendance-history": "node scripts/fetch-attendance-history.js",
    "fetch:official-feed": "node scripts/fetch-official-feed.js",
    "validate:data": "node scripts/validate-data.js",
    "fetch:all": "node scripts/fetch-all.js && node scripts/validate-data.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
